opam-version: "2.0"
name: "ledger-calculus"
version: "dev"
synopsis: "Ledger Calculus: cancellable linear futures, formalized in Rocq"
maintainer: "Ricky"
authors: ["Ricky"]
license: "BSD-3-Clause"
homepage: "https://github.com/rickyraz/ledger-calculus"
bug-reports: "https://github.com/rickyraz/ledger-calculus/issues"
# Version range compatible with the development machine
# (rocq-core 9.1.0, rocq-stdlib 9.0.0) and the CI image
# rocq/rocq-prover:9.1 (rocq-core 9.1.1, rocq-stdlib 9.1.0).
depends: [
  "rocq-core" {>= "9.1.0" & < "9.2.0"}
  "rocq-stdlib" {>= "9.0.0" & < "9.2.0"}
  "dune" {>= "3.21"}
]
build: ["dune" "build" "-p" name "-j" jobs]
