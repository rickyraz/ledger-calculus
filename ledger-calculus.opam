opam-version: "2.0"
name: "ledger-calculus"
version: "dev"
synopsis: "Ledger Calculus: cancellable linear futures, formalized in Rocq"
maintainer: "Ricky"
authors: ["Ricky"]
license: "BSD-3-Clause"
# Versi persis dari mesin pengembangan (Rocq Platform 2026.07.0, Windows):
# rocq --version = 9.1.0, dune --version = 3.21.0. rocq-stdlib mengikuti
# package pick Rocq Platform 9.1~2026.01.
depends: [
  "rocq-core" {= "9.1.0"}
  "rocq-stdlib" {= "9.0.0"}
  "dune" {>= "3.21"}
]
build: ["dune" "build" "-p" name "-j" jobs]
